# Cloudflare Pages response headers.
#
# The Content-Security-Policy lists exactly what the pages load, checked in a
# browser against every page type, every dashboard tab, the Leaflet map, the
# video player, the Commons gallery and the Google Maps frame:
#   scripts     own files, the inline blocks and onerror handlers in the pages
#               ('unsafe-inline' is needed for those), Leaflet from unpkg, the
#               YouTube player API, Cloudflare's analytics beacon (injected at
#               the edge) and Cloudflare's own /cdn-cgi/ scripts (same origin)
#   styles      own, inline, Google Fonts, Leaflet's stylesheet
#   fonts       own TTFs and fonts.gstatic.com
#   images      any https host: news thumbnails come from every newsroom, map
#               tiles from Esri/OpenTopoMap/OpenStreetMap, photographs from
#               Wikimedia, video stills from ytimg
#   fetch       own /api and JSON files, the Wikimedia Commons API, the
#               analytics beacon's endpoint
#   frames      YouTube embeds and the Google Maps box (maps.google.com
#               redirects to www.google.com)
# If a new third-party resource is added to a page, add its host here first,
# or the browser silently refuses to load it.
#
# These rules apply to static files only. /embed is a Pages Function and sets
# its own `frame-ancestors *`, which is what lets other sites frame it.

# HTML is revalidated at the edge every minute. Article pages were seen being
# served from cache with an Age of seven hours, which on a live disaster site
# means a reader gets a casualty figure that has moved twice since.
/*
  Cache-Control: public, max-age=60, stale-while-revalidate=600
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://www.youtube.com https://s.ytimg.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://commons.wikimedia.org https://cloudflareinsights.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://maps.google.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests

# The figures box other sites paste in. Served by functions/embed.js, which
# the rules above do not reach; stated here so that a static copy of it would
# stay embeddable too.
/embed
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors *

# Stylesheet has no content hash in its name, so it is revalidated hourly and
# served stale while that happens rather than blocking a page load.
/assets/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# The share and card pictures were being answered with `Content-Type:
# text/html`. Paired with the `nosniff` above — which is correct and stays —
# a browser refuses to decode them, so every card's photograph failed to load
# and the cards collapsed to text. Stating the type here settles it.
/assets/og/*
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/sitemap-index.xml
  Content-Type: application/xml; charset=utf-8

/news-sitemap.xml
  Content-Type: application/xml; charset=utf-8

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/favicon-96x96.png
  Cache-Control: public, max-age=604800

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400

/qr-pmo-nepal.jpg
  Cache-Control: public, max-age=86400

# Data files the dashboard fetches. Short cache: these carry casualty figures.
/event.json
  Cache-Control: public, max-age=60, stale-while-revalidate=300
  Access-Control-Allow-Origin: *

/today.json
  Cache-Control: public, max-age=60, stale-while-revalidate=300
  Access-Control-Allow-Origin: *
